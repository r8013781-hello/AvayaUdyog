# Copy to .env.local for local development (that file is gitignored).
# In production, set this as a real build-time environment variable on
# the host — Next.js inlines NEXT_PUBLIC_* values into the static output
# at build time.

# The Express/Supabase backend — unchanged, used by both the marketing
# enquiry form and the CRM at /portal. Points at localhost here for local
# dev; production builds should set this to the real backend:
# NEXT_PUBLIC_API_BASE_URL=https://avayaudyog.onrender.com/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Analytics + Ads — all optional. Unset in local dev; Analytics.jsx renders
# nothing and lib/tracking.js no-ops when these are absent, so leaving them
# blank never breaks a build. Fill in with real IDs from the GA4 property
# and Google Ads account before running paid campaigns.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_CALL_CONVERSION_LABEL=xxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_GOOGLE_ADS_FORM_CONVERSION_LABEL=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Google Business Profile (review sync) ----
# Backend-only; these live in backend/.env, NOT here — listed for reference.
# Until all five are set, the CRM shows "Google isn't connected yet" and the
# super admin can still add real reviews manually. Requires a verified
# Business Profile plus approved Business Profile API access from Google.
#   GOOGLE_CLIENT_ID=
#   GOOGLE_CLIENT_SECRET=
#   GOOGLE_REFRESH_TOKEN=
#   GOOGLE_BUSINESS_ACCOUNT_ID=
#   GOOGLE_BUSINESS_LOCATION_ID=
