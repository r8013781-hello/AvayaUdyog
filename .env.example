# Copy to .env.local for local development (that file is gitignored).
# In production, set this as a real build-time environment variable on
# the host — Next.js inlines NEXT_PUBLIC_* values into the static output
# at build time.

# The Express/Supabase backend — unchanged, used by both the marketing
# enquiry form and the CRM at /portal. Points at localhost here for local
# dev; production builds should set this to the real backend:
# NEXT_PUBLIC_API_BASE_URL=https://avayaudyog.onrender.com/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
