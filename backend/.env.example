# ---------------------------------------------------------------------------
# Avaya Udyog CRM — Backend Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# ---------------------------------------------------------------------------

# ── Supabase / PostgreSQL ───────────────────────────────────────────────────
# Connection string from Supabase: Project Settings → Database → Connection string
# Use the "URI" format, e.g.:
#   postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# SSL — set to "false" only for a local PostgreSQL instance with no SSL.
# For Supabase always leave this unset or set to "true".
DB_SSL=true

# Optional: maximum connections in the pool (default: 10)
# DB_POOL_MAX=10

# ── Authentication ──────────────────────────────────────────────────────────
# Long random string — generate with:
#   node -e "console.log(require('crypto').randomBytes(40).toString('hex'))"
JWT_SECRET=change-this-before-deploying

# ── Seed script (backend/scripts/seedAdmin.js) ──────────────────────────────
# Used once to create the first CRM employee login.
ADMIN_EMPLOYEE_CODE=RAHUL
ADMIN_NAME=Rahul
ADMIN_PASSWORD=change-before-deploying

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001

# Comma-separated list of allowed CORS origins.
# In production set to your frontend URL, e.g. https://www.avayaudyog.com
CORS_ORIGIN=http://localhost:5173

# ── Optional ─────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
