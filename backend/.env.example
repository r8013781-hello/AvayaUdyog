# ---- Database ----
# PostgreSQL (Supabase in production). lib/db.js reads DATABASE_URL and
# nothing else — the DB_SERVER / DB_AUTH / DB_ODBC_DRIVER variables that used
# to live here were from the old SQL Server stack and are no longer read by
# any code. Anything still carrying them locally can drop them.
#
# Required by the server AND by the migration runner (npm run migrate):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Local PostgreSQL only — Supabase always requires SSL, so leave this unset
# in production.
# DB_SSL=false

# Auth
JWT_SECRET=local-avaya-crm-test-secret-change-before-deploying

# Seed script (backend/scripts/seedAdmin.js) — first employee login
ADMIN_EMPLOYEE_CODE=RAHUL
ADMIN_NAME=Rahul
ADMIN_PASSWORD=rahul

# Server
PORT=3001
# Comma-separated list of origins allowed to call this API.
#
# 3000 is the Next dev server (`npm run dev` at the repo root) — it serves BOTH
# the marketing site and the CRM at /portal, so without it the enquiry form,
# the public reviews fetch on the homepage and the whole of /portal fail with a
# CORS preflight error in local development. 5173 is the old Vite app's port,
# kept only for anyone still running it.
#
# In production this must be the real site origin, e.g.
#   CORS_ORIGIN=https://avayaudyog.com,https://www.avayaudyog.com
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

SENDGRID_API_KEY=

# ---- Google Business Profile (review sync) ----
# All five are required before POST /api/reviews/sync will work. Obtain them
# from a Google Cloud project with Business Profile API access approved, using
# an OAuth account that manages the business's profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
