# SQL Server connection
# This project runs on the local default SQL Server instance.
# 192.168.31.160 is this PC's Wi-Fi address, not the SQL Server address.
DB_SERVER=localhost
DB_NAME=avaya_crm
DB_AUTH=windows
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Auth
JWT_SECRET=local-avaya-crm-test-secret-change-before-deploying

# Seed script (backend/scripts/seedAdmin.js) — first employee login
ADMIN_EMPLOYEE_CODE=RAHUL
ADMIN_NAME=Rahul
ADMIN_PASSWORD=rahul

# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173

SENDGRID_API_KEY=
