# Marketing site environment variables — copy to .env.local for dev.
# In production (Render/wherever this app is deployed) set these as real
# build-time environment variables; Next.js inlines NEXT_PUBLIC_* values
# into the static output at build time, same as Vite does with VITE_*.

# The existing CRM backend (unchanged) — same value the Vite app's
# VITE_API_BASE_URL currently points at.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Where the "Login" link in the navbar points. Until the CRM is actually
# cut over to portal.avayaudyog.com (see the migration report's final
# section), set this to wherever the CRM is reachable today.
NEXT_PUBLIC_PORTAL_URL=https://portal.avayaudyog.com/
